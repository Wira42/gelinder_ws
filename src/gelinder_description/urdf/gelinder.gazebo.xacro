<?xml version="1.0" ?>
<robot name="Gelinder" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================================================================
       Gazebo (gz-sim / Ignition Fortress) specific tags.

       Notes for whoever edits this next:
       - Gazebo Fortress (gz-sim) does NOT understand the old Gazebo-Classic
         <material>Gazebo/Silver</material> OGRE script syntax, so we do not
         set <material> here. Visual color already comes from the
         <material name="silver"> block defined in the URDF/xacro itself.
       - Friction in gz-sim is set per-collision via
         <surface><friction><ode><mu>/<mu2></ode></friction></surface>,
         not the flat <mu1>/<mu2> tags used by Gazebo Classic.
       =================================================================== -->

  <xacro:macro name="gz_friction" params="link mu:=0.6 mu2:=0.6">
    <gazebo reference="${link}">
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>${mu}</mu>
              <mu2>${mu2}</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </gazebo>
  </xacro:macro>

  <xacro:gz_friction link="base_link" />
  <xacro:gz_friction link="arm_a_0_1" />
  <xacro:gz_friction link="arm_a_1_1" />
  <xacro:gz_friction link="arm_a_2_1" />
  <xacro:gz_friction link="arm_b_0_1" />
  <xacro:gz_friction link="arm_b_1_1" />
  <xacro:gz_friction link="arm_b_2_1" />
  <xacro:gz_friction link="arm_c_0_1" />
  <xacro:gz_friction link="arm_c_1_1" />
  <xacro:gz_friction link="arm_c_2_1" />
  <xacro:gz_friction link="arm_d_0_1" />
  <xacro:gz_friction link="arm_d_1_1" />
  <xacro:gz_friction link="arm_d_2_1" />

  <!-- gz_ros2_control plugin: bridges ros2_control to the Gazebo Fortress
       physics engine. The actual controller list/type is configured via
       config/gelinder_controllers.yaml, loaded by the gazebo.launch.py
       launch file. -->
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find gelinder_description)/config/gelinder_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
